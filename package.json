{
  "name": "keploy-reels",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render BlastRadius out/blast-radius.mp4",
    "still": "remotion still BlastRadius",
    "render:short": "remotion render Regressions40 out/regressions-40s.mp4",
    "render:tight": "remotion render Regressions30 out/regressions-30s.mp4",
    "render:all": "npm run render && npm run render:short && npm run render:tight",
    "check": "node scripts-lint-tokens.mjs && node scripts-check-variants.mjs && tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.417",
    "@remotion/google-fonts": "4.0.417",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.417"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "typescript": "5.6.3"
  }
}
